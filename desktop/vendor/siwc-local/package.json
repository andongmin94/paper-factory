{
  "name": "@siwc/local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "LICENSE", "THIRD_PARTY_NOTICES.md", "docs/dependency-inventory.json"],
  "main": "./dist/index.js",
