{
  "name": "paper-factory-desktop",
  "version": "0.9.1",
  "private": true,
  "description": "Paper Factory Windows desktop workspace, based on create-frontron",
  "license": "MIT",
  "author": "Paper Factory contributors",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "node scripts/tasks.mjs app",
    "app": "node scripts/tasks.mjs app",
    "dev:renderer": "node scripts/tasks.mjs dev",
    "typecheck": "node scripts/tasks.mjs typecheck",
    "build": "node scripts/tasks.mjs build",
    "package": "node scripts/tasks.mjs package",
    "package:dir": "node scripts/tasks.mjs package --dir",
    "test": "node scripts/tasks.mjs test",
    "lint": "node scripts/tasks.mjs lint",
    "format": "node scripts/tasks.mjs format",
    "format:check": "node scripts/tasks.mjs format:check"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "io.github.andongmin94.paperfactory",
    "productName": "Paper Factory",
    "icon": "public/icon.png",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "afterExtract": "./scripts/after-extract.mjs",
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "msi",
        "portable"
      ]
    },
    "msi": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "public/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "output"
    }
  },
  "productName": "Paper Factory"
}
