{
  "name": "paper-factory-desktop",
  "version": "0.14.11",
  "private": true,
  "description": "Paper Factory standalone research desktop",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "workspaces": [
    "vendor/siwc-local"
  ],
  "scripts": {
    "typecheck": "npm run build --workspace @siwc/local && tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs && vite build",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/*.test.mjs && npm run test --workspace @siwc/local",
    "test:electron": "playwright test",
    "build:runtime": "node scripts/build-runtime.mjs",
    "package:app": "npm run build:runtime && npm run build && electron-builder && node scripts/verify-package.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@siwc/local": "file:vendor/siwc-local",
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "build": {
    "appId": "com.andongmin.paperfactory.standalone",
    "productName": "Paper Factory",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.js",
      "dist/preload.cjs",
      "dist/renderer/**",
      "dist/LICENSE",
      "package.json",
      "third-party/**",
      "vendor/siwc-local/PROVENANCE.md",
      "vendor/siwc-local/LICENSE",
      "vendor/siwc-local/THIRD_PARTY_NOTICES.md",
      "vendor/siwc-local/docs/dependency-inventory.json"
    ],
    "win": {
      "target": "nsis",
      "extraResources": [{ "from": "runtime/win32-${arch}", "to": "runtime", "filter": ["**/*"] }]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "extraResources": [{ "from": "runtime/darwin-${arch}", "to": "runtime", "filter": ["**/*"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "electron-winstaller": false
  }
}
