# Blank public template. Copy to .env and fill locally; never commit the real file.
# Load explicitly with the separate CLI --env-file option.
# The plugin reads host process environment settings and does not load .env.
# No automatic .env lookup; this file does not configure the host assistant model.
PF_AUTHOR_GIVEN_NAME=
PF_AUTHOR_FAMILY_NAME=
PF_AUTHOR_DISPLAY_NAME=
PF_AUTHOR_EMAIL=
PF_AUTHOR_ORCID=
PF_AUTHOR_AFFILIATION=
PF_AUTHOR_DEPARTMENT=
PF_AUTHOR_CITY=
PF_AUTHOR_COUNTRY=
PF_AUTHOR_SCHOLAR_ID=
PF_AUTHOR_GITHUB=
PF_AUTHOR_HOMEPAGE=
PF_AUTHOR_PROFILE_JSON=
# Existing process bindings (including empty ones) take precedence over this file.
# Nonempty author precedence: JSON profile < individual PF_AUTHOR_* < explicit author JSON.
# Dotenv is plain text; final paper artifacts still include supplied author information.
# Optional: PF_HOME overrides the external workspace and current-project directory.
# OJS 3.5 author API bearer token for the separate manual CLI workflow.
# Never commit or paste the real token into JSON.
PF_OJS_API_TOKEN=
# Optional node.exe path for the native Windows research worker.
PF_NODE_BIN=
# Linux Docker worker only: immutable image ID from scripts/build_autonomous_image.py.
# Native Windows uses AppContainer + a bounded Job Object; leave this blank there.
PF_RESEARCH_IMAGE=
