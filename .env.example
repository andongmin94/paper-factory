# Blank public template. Copy to .env and fill locally; never commit the real file.
# Load explicitly: paperfactory --env-file .env <command> (no automatic lookup).
# Export helper: python scripts/build_research_artifacts.py <studies> --env-file .env
PF_AUTHOR_GIVEN_NAME=
PF_AUTHOR_FAMILY_NAME=
PF_AUTHOR_DISPLAY_NAME=
PF_AUTHOR_EMAIL=
PF_AUTHOR_ORCID=
PF_AUTHOR_AFFILIATION=
PF_AUTHOR_DEPARTMENT=
PF_AUTHOR_CITY=
PF_AUTHOR_COUNTRY=
PF_AUTHOR_SCHOLAR_ID=
PF_AUTHOR_GITHUB=
PF_AUTHOR_HOMEPAGE=
PF_AUTHOR_PROFILE_JSON=
# Existing process bindings (including empty ones) take precedence over this file.
# Nonempty author precedence: JSON profile < individual PF_AUTHOR_* < explicit author JSON.
# Dotenv is plain text; final paper artifacts still include supplied author information.
# Optional: PF_HOME overrides the external workspace and current-project directory.
# OJS 3.5 author API bearer token. Never commit or paste the real token into JSON.
PF_OJS_API_TOKEN=
# Autonomous research uses the official Codex CLI's ChatGPT subscription login.
# Keep login state in the official CLI store; do not put OAuth tokens here.
# Optional trusted CLI path; defaults to codex inside the selected venv, then PATH.
# Windows npm launchers are resolved to node.exe + official codex.js without a shell.
PF_CODEX_BIN=
PF_CODEX_MODEL=
# Optional node.exe path for the native Windows research worker.
PF_NODE_BIN=
## Optional private official-CLI connection store (outside Git).
## Defaults to PF_HOME/codex-auth. Contains credentials after official login.
PF_CODEX_AUTH_HOME=
# Linux Docker worker only: immutable image ID from scripts/build_autonomous_image.py.
# Native Windows uses AppContainer + a bounded Job Object; leave this blank there.
PF_RESEARCH_IMAGE=
